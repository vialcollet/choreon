# Copy to .env (git-ignored). Everything is optional: API keys can also be entered in
# Studio settings ▸ API keys. A value set here always wins over the one saved in the app.

# Claude. Without a key, agents use your Claude subscription (Claude Code signed in: `claude`).
ANTHROPIC_API_KEY=

# Dictation (speech-to-text in every field): Groq or OpenAI Whisper.
GROQ_API_KEY=
OPENAI_API_KEY=

# Voice-over: Gemini reads the script in one take; Groq Whisper (above) times every word.
GEMINI_API_KEY=

# Jev (note routing). Without it, notes are routed by Claude Haiku, then by a heuristic.
TYPESAFE_API_KEY=

# Sessions. Generated and stored in data/ when empty.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5610

# Service token for local scripts (scripts/shot.mjs, CLI captures). Leave empty to disable.
STUDIO_TOKEN=
